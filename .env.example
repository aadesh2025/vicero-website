# The Vicero app (login/signup deep-link here). No secrets belong in this site.
NEXT_PUBLIC_APP_URL=https://viceroai.duckdns.org
# Public docs (defaults to ${NEXT_PUBLIC_APP_URL}/docs)
NEXT_PUBLIC_DOCS_URL=
# Canonical URL of this site, used for metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Where the contact form sends mail
NEXT_PUBLIC_CONTACT_EMAIL=hello@vicero.ai
